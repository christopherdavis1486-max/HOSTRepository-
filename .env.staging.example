# HOST staging environment — copy to .env.staging.local for local preflight.
# Never commit .env.staging.local or paste its values into chat.

DATABASE_URL=postgresql://staging_user:password@staging-host/host_staging?sslmode=verify-full

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_V2_WEBHOOK_SECRET=whsec_...

AUTH_SECRET=
APP_URL=https://your-host-staging-domain.example
NEXTAUTH_URL=https://your-host-staging-domain.example
AUTH_WEBAUTHN_ORIGIN=https://your-host-staging-domain.example

CRON_SECRET=
UPSTASH_REDIS_REST_URL=https://your-staging-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=
SECURITY_REQUIRE_DISTRIBUTED_RATE_LIMIT=true

# Email remains disabled until the staging Resend sender/domain is ready.
REQUIRE_EMAIL_VERIFICATION=false
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=HOST <notifications@your-verified-domain.example>

# Safe staging defaults while Stripe's Funds Segregation review is pending.
ENABLE_DELAYED_CHARGE_BOOKINGS=false
ENABLE_AUTOMATED_OFFSESSION_CHARGING=false
ENABLE_HOST_TRANSFER_EXECUTION=false
HOST_TAX_TREATMENT=unconfigured

NEXT_PUBLIC_SHOW_STAGING_UI=true

# Optional: required only for the isolated Connect transfer test.
STRIPE_TEST_CONNECT_ACCOUNT_ID=
