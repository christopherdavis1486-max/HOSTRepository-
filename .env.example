# HOST booking/payments backend — environment variables

# Same database as host-atlas-backend, ideally — see README's
# "Combining with the Atlas package" section.
DATABASE_URL=postgresql://user:password@host:5432/host

# Stripe test keys — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Accounts v2 thin-event signing secret — from a SEPARATE Stripe Dashboard
# Event Destination registration (Workbench → Webhooks → Add destination,
# payload type "thin"), NOT the same value as STRIPE_WEBHOOK_SECRET above.
# Received by app/api/webhooks/stripe-v2/route.ts, a distinct route from
# the classic v1 webhook — the two secrets/routes are deliberately never
# merged. See STRIPE_SANDBOX_SETUP.md for exact Event Destination config.
STRIPE_V2_WEBHOOK_SECRET=whsec_...
# Publishable key — safe to expose client-side (NEXT_PUBLIC_ prefix), needed
# by components/CheckoutForm.tsx to initialize Stripe.js in the browser.
# This was missing entirely until the Stripe Sandbox prep pass — the
# backend was returning a clientSecret with nothing client-side able to
# use it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_WEBAUTHN_ORIGIN=http://localhost:3000
# Set true in production after RESEND_API_KEY and EMAIL_FROM_ADDRESS are configured.
REQUIRE_EMAIL_VERIFICATION=false

# Production distributed rate limiting. Production auth and financial
# mutations fail closed until these are configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SECURITY_REQUIRE_DISTRIBUTED_RATE_LIMIT=false

# Vercel Cron authentication. Generate a long random value; Vercel sends it
# as a Bearer token when invoking /api/cron/sweep.
CRON_SECRET=

# Required in production/staging — next-auth (v4) reads this directly
# from the environment itself; nothing in this codebase references it in
# source. Without it, NextAuth logs a warning and falls back to inferring
# the URL from request headers, which is unreliable behind a platform
# like Vercel. Set this to your actual deployment URL, e.g.
# https://your-app.vercel.app — never hard-code a URL in source for this.
NEXTAUTH_URL=http://localhost:3000

# Optional — Google sign-in. Leave blank to disable it (credentials
# sign-in still works without these).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — https://resend.com/api-keys. Required for any notification to
# actually send; sendEmail() throws clearly if this is missing rather
# than silently no-op-ing.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=HOST <notifications@yourdomain.com>

APP_URL=http://localhost:3000
NODE_ENV=development

# Financial architecture activation gates. Keep all three false until the
# Stripe Funds Segregation review and HOST's tax treatment are resolved.
ENABLE_DELAYED_CHARGE_BOOKINGS=false
ENABLE_AUTOMATED_OFFSESSION_CHARGING=false
ENABLE_HOST_TRANSFER_EXECUTION=false
HOST_TAX_TREATMENT=unconfigured

# Makes the local/staging navigation controls visible. Never required in live.
NEXT_PUBLIC_SHOW_STAGING_UI=false

# Optional isolated Stripe test harness destination.
STRIPE_TEST_CONNECT_ACCOUNT_ID=
